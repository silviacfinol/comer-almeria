<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- Elemento raíz -->
  <xs:element name="visitas">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="visita" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <!-- Fecha en formato YYYY-MM-DD -->
              <xs:element name="fecha" type="xs:date"/>

              <!-- Hora en formato HH:MM -->
              <xs:element name="hora">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="([01][0-9]|2[0-3]):[0-5][0-9]"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <!-- Página visitada: valores permitidos -->
              <xs:element name="pagina">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="trabajo_comer_almeria"/>
                    <xs:enumeration value="restaurantes"/>
                    <xs:enumeration value="cafeterias"/>
                    <xs:enumeration value="baresytapas"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <!-- Navegador: valores permitidos -->
              <xs:element name="navegador">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="chrome"/>
                    <xs:enumeration value="firefox"/>
                    <xs:enumeration value="edge"/>
                    <xs:enumeration value="safari"/>
                    <xs:enumeration value="opera"/>
                    <xs:enumeration value="brave"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <!-- Duración en segundos: entero entre 1 y 3600 -->
              <xs:element name="duracion">
                <xs:simpleType>
                  <xs:restriction base="xs:integer">
                    <xs:minInclusive value="1"/>
                    <xs:maxInclusive value="3600"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
